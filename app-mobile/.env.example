# URL pública da API, sem barra final. Variáveis EXPO_PUBLIC_* ficam visíveis no bundle.
EXPO_PUBLIC_API_BASE=http://IP_ATUAL_DO_COMPUTADOR:8000

# Somente em desenvolvimento: simula a data visual das campanhas (AAAA-MM-DD).
# Nunca altera regras financeiras; remova ou deixe vazio em builds reais.
EXPO_PUBLIC_CAMPAIGN_PREVIEW_DATE=

# Opcionais para upload público de avatar via Cloudinary (não use um preset assinado).
EXPO_PUBLIC_CLOUDINARY_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
