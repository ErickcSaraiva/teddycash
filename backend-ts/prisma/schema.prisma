// Configuração do Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Conexão com o banco de dados PostgreSQL.
// A URL é fornecida pela configuração Prisma do projeto.
datasource db {
  provider = "postgresql"
}

// Usuários, créditos financeiros, cashback legado e TeddyCoins promocionais.
model User {
  id             String            @id @default(uuid())
  username       String            @unique
  email          String            @unique
  password       String
  avatarUrl      String?
  creditBalance  Int               @default(0)
  cashback       Float             @default(0.0)
  teddyCoins     Int               @default(0)
  sessionVersion Int               @default(0)
  privacyStatus  UserPrivacyStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  transactions          Transaction[]
  gameSessions          GameSession[]
  authorizations        MachineAuthorization[]
  paymentOrders         PaymentOrder[]
  teddyCoinTransactions TeddyCoinTransaction[]
  privacyRequests       PrivacyRequest[]
  privacyConsents       PrivacyConsent[]
}

enum UserPrivacyStatus {
  ACTIVE
  DELETION_PENDING
  ANONYMIZED
}

enum PrivacyRequestType {
  EXPORT
  DELETION
}

enum PrivacyRequestStatus {
  AWAITING_CONFIRMATION
  PENDING_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model PrivacyRequest {
  id                 String               @id @default(uuid())
  userId             String
  type               PrivacyRequestType
  status             PrivacyRequestStatus
  noticeVersion      String
  decisionReasonCode String?
  requestedAt        DateTime             @default(now())
  confirmedAt        DateTime?
  processedAt        DateTime?
  cancelledAt        DateTime?
  updatedAt          DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
}

model PrivacyConsent {
  id            String    @id @default(uuid())
  userId        String
  purpose       String
  version       String
  noticeVersion String
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose, grantedAt])
}

model PrivacyAuditLog {
  id         String   @id @default(uuid())
  actorHash  String
  action     String
  targetType String
  targetHash String?
  occurredAt DateTime @default(now())

  @@index([actorHash, occurredAt])
  @@index([action, occurredAt])
}

enum CreditTransactionType {
  CREDIT_PURCHASE
  MACHINE_UNLOCK
  ADMIN_ADJUSTMENT
  LEGACY_PIX_CREDIT
  LEGACY_TEDDY_COIN_REDEMPTION
}

enum CreditTransactionSource {
  PAYMENT_ORDER
  MACHINE_AUTHORIZATION
  ADMIN
  LEGACY
}

// Ledger exclusivo dos créditos financeiros usados nas máquinas.
model Transaction {
  id           String                  @id @default(uuid())
  userId       String
  amount       Int
  type         CreditTransactionType
  source       CreditTransactionSource @default(LEGACY)
  referenceId  String?
  balanceAfter Int?
  machineId    String?
  channel      MachineChannel?
  createdAt    DateTime                @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type, referenceId])
  @@index([userId, createdAt])
  @@index([machineId, createdAt])
  @@index([referenceId])
}

// Configurações globais do Live-Ops.
model ThemeSettings {
  id          Int      @id @default(1)
  theme       String   @default("default")
  particles   String   @default("none")
  lastUpdated DateTime @updatedAt
}

// Sessões do motor de gamificação.
model GameSession {
  id             String            @id @default(uuid())
  userId         String
  gameId         String
  status         GameSessionStatus @default(STARTED)
  tokenHash      String?           @unique
  expiresAt      DateTime?
  score          Int?
  eventCount     Int?
  resultHash     String?
  rejectedReason String?
  coinsEarned    Int               @default(0)
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?
  won            Boolean?
  createdAt      DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, gameId, startedAt])
  @@index([status, expiresAt])
}

enum GameSessionStatus {
  STARTED
  COMPLETED
  EXPIRED
  REJECTED
}

enum TeddyCoinTransactionType {
  CREDIT_PURCHASE_REWARD
  DAILY_CHECKIN
  GAME_ENTRY
  GAME_REWARD
  CREDIT_REDEMPTION
  ADMIN_ADJUSTMENT
}

enum TeddyCoinTransactionSource {
  CHECK_IN
  PAYMENT_ORDER
  GAME_SESSION
  CAMPAIGN
  ADMIN
  LEGACY
}

model TeddyCoinTransaction {
  id           String                     @id @default(uuid())
  userId       String
  type         TeddyCoinTransactionType
  source       TeddyCoinTransactionSource @default(LEGACY)
  amount       Int
  balanceAfter Int
  referenceId  String?
  description  String?
  createdAt    DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type, referenceId])
  @@index([userId, createdAt])
  @@index([referenceId])
}

// Ciclo de vida da autorização entregue à máquina por QR Code ou NFC.
enum MachineAuthorizationStatus {
  PENDING
  PROCESSING
  CONSUMED
  CANCELLED
}

enum MachineChannel {
  QR
  NFC
}

model Machine {
  id         String   @id
  name       String
  active     Boolean  @default(true)
  qrEnabled  Boolean  @default(true)
  nfcEnabled Boolean  @default(false)
  apiKeyHash String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Uma autorização é criada no app, lida pela máquina e consumida uma única vez.
// O saldo só é debitado no resgate confirmado pela máquina.
model MachineAuthorization {
  id        String                     @id @default(uuid())
  token     String                     @unique
  userId    String
  machineId String
  amount    Int
  channel   MachineChannel
  status    MachineAuthorizationStatus @default(PENDING)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([machineId, status])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

enum PaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model PaymentOrder {
  id          String             @id @default(uuid())
  userId      String
  packageCode String
  amountCents Int
  credits     Int
  teddyCoins  Int                @default(0)
  cashback    Float              @default(0)
  provider    String?
  providerId  String?            @unique
  status      PaymentOrderStatus @default(PENDING)
  paidAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}
