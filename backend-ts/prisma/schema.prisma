// Configuração do Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Conexão com o banco de dados PostgreSQL.
// A URL é fornecida pela configuração Prisma do projeto.
datasource db {
  provider = "postgresql"
}

// Usuários, saldo e cashback.
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  balance   Float    @default(0.0)
  cashback  Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions   Transaction[]
  gameSessions   GameSession[]
  authorizations MachineAuthorization[]
}

// Extrato de créditos e débitos.
model Transaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  type      String
  machineId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([machineId, createdAt])
}

// Configurações globais do Live-Ops.
model ThemeSettings {
  id          Int      @id @default(1)
  theme       String   @default("default")
  particles   String   @default("none")
  lastUpdated DateTime @updatedAt
}

// Sessões do motor de gamificação.
model GameSession {
  id          String   @id @default(uuid())
  userId      String
  coinsEarned Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// Ciclo de vida da autorização entregue à máquina por QR Code ou NFC.
enum MachineAuthorizationStatus {
  PENDING
  PROCESSING
  CONSUMED
}

// Uma autorização é criada no app, lida pela máquina e consumida uma única vez.
// O saldo só é debitado no resgate confirmado pela máquina.
model MachineAuthorization {
  id        String                     @id @default(uuid())
  token     String                     @unique
  userId    String
  machineId String
  amount    Float
  channel   String
  status    MachineAuthorizationStatus @default(PENDING)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([machineId, status])
  @@index([expiresAt])
  @@index([userId, createdAt])
}
