DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
GAME_SECRET=replace-with-a-different-long-random-secret
FRONTEND_URL=http://localhost:8081
# Alternativa/lista adicional, separada por vírgulas:
ALLOWED_ORIGINS=
REWARDS_TIME_ZONE=America/Manaus

# Apenas para seed local explícito; nunca execute seed automaticamente em produção.
DEMO_PASSWORD=
DEMO_MACHINE_API_KEY=
